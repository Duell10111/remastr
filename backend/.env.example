# Copy to backend/.env and fill in. All settings: backend/src/remastr/config.py

# --- Server ---
# 127.0.0.1 = only this PC. For access from other machines (Mac, MCP clients) use 0.0.0.0
# and set an API token. allowed_hosts must list the host names clients use (DNS rebinding protection).
REMASTR_HOST=127.0.0.1
REMASTR_PORT=8765
REMASTR_API_TOKEN=
REMASTR_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]

# Private CA (PEM) for Plex HTTPS and FTPS, e.g. mkcert's rootCA.pem (find it with `mkcert -CAROOT`).
# Leave empty for publicly trusted certificates. FTPS certificates are always verified.
REMASTR_CA_BUNDLE=

# --- Plex --- (token: https://support.plex.tv/articles/204059436)
REMASTR_PLEX_URL=http://plex.local:32400
REMASTR_PLEX_TOKEN=

# --- FTP ---
REMASTR_FTP_HOST=plex.local
# SFTPGo's FTP service usually listens on 2121
REMASTR_FTP_PORT=21
REMASTR_FTP_USER=
REMASTR_FTP_PASSWORD=
REMASTR_FTP_TLS=true
# Plex library path -> same folder on the FTP server
REMASTR_PATH_MAPPINGS=[{"plex": "/data/tv", "ftp": "/tv"}, {"plex": "/data/movies", "ftp": "/movies"}]
# Originals replaced in "replace" mode are moved here. Must NOT be inside a Plex library.
REMASTR_FTP_ARCHIVE_ROOT=/remastr-archive
REMASTR_VERSION_SUFFIX=" - {height}p Remastr"

# --- Local processing (Windows PC with NVIDIA GPU) ---
REMASTR_WORK_DIR=F:/Remastr
REMASTR_STAXRIP_DIR=F:/Tools/StaxRip/StaxRip-v2.52.6-x64
REMASTR_VSMLRT_DIR=F:/Tools/vs-mlrt
REMASTR_TARGET_HEIGHT=1080
